# PostgreSQL connection string
DATABASE_URL="postgresql://hooked:hooked@localhost:5432/hooked"

# Public site URL (used in sitemap and robots)
SITE_URL="https://hooked.example.com"

# Claude API. Without a key, AI features fall back to rule-based suggestions.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# ANTHROPIC_MODEL_QUICK="claude-haiku-4-5-20251001"

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="编辑部"

# Contact addresses shown on legal pages
CONTACT_EMAIL="support@example.com"
DMCA_EMAIL="dmca@example.com"
COMPANY_NAME=""

# Praise-board thresholds (defaults shown)
# RANK_PRAISE_MIN_VOTES=30
# RANK_PRAISE_MIN_COMPLETION=0.4
# RANK_PRAISE_PRIOR=30

# Comma-separated words that are rejected in user text
# MODERATION_BLOCKLIST=""

# AI comic adaptation: application thresholds and the author's share of net revenue (defaults shown)
# ADAPT_MIN_READS=1000
# ADAPT_MIN_COMPLETION=0.5
# ADAPT_MIN_VOTES=30
# ADAPT_MIN_RATING=8
# ADAPT_MIN_DAYS=7
# ADAPT_AUTHOR_SHARE=0.2
